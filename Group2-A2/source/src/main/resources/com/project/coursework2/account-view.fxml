<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.coursework2.controller.AccountController"
            fitToWidth="true"
            style="-fx-background-color: #F5F7FB;">

    <VBox spacing="20" style="-fx-background-color: #F5F7FB; -fx-padding: 30;">

        <Label text="ACCOUNT"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2E3440;"/>

        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #DDE3EE; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(36,48,68,0.06), 8, 0, 0, 2);" maxWidth="520">

            <Label text="PROFILE"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2E3440;
                          -fx-border-color: transparent transparent #DDE3EE transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;"/>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="First Name" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                    <TextField fx:id="firstNameField" style="-fx-background-color: #FFFFFF; -fx-border-color: #DDE3EE; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 8 10;"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Last Name" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                    <TextField fx:id="lastNameField" style="-fx-background-color: #FFFFFF; -fx-border-color: #DDE3EE; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 8 10;"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Email Address" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                <TextField fx:id="emailField" style="-fx-background-color: #FFFFFF; -fx-border-color: #DDE3EE; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="User ID" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                <TextField fx:id="idField" editable="false"
                           style="-fx-background-color: #F8FAFE; -fx-text-fill: #6B7280;
                                  -fx-border-color: #DDE3EE; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 8 10;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="New Password" style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
                <PasswordField fx:id="passwordField" promptText="Leave blank to keep current password" style="-fx-background-color: #FFFFFF; -fx-border-color: #DDE3EE; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 8 10;"/>
            </VBox>

            <Label fx:id="statusLabel" text="" wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #5E7CE2;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Edit" onAction="#handleEdit"
                        style="-fx-background-color: #6B7280; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 7 16;"/>
                <Button text="Save" onAction="#handleSave"
                        style="-fx-background-color: #5E7CE2; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 7 16;"/>
            </HBox>

        </VBox>

        <HBox alignment="CENTER_LEFT" spacing="15"
              style="-fx-background-color: #FFF7F7; -fx-padding: 18; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #E8B6B6; -fx-border-width: 1;"
              maxWidth="520">
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label text="Delete Account"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #D96C6C;"/>
                <Label text="This will remove your account from the system."
                       style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
            </VBox>
            <Button text="Delete Account" onAction="#handleDeleteAccount"
                    style="-fx-background-color: #D96C6C; -fx-text-fill: white;
                           -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 7 16;"/>
        </HBox>

    </VBox>
</ScrollPane>
