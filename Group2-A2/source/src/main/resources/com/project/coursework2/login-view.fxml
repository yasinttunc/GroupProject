<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.project.coursework2.controller.LoginController"
      alignment="CENTER"
      spacing="15"
      style="-fx-background-color: #F5F7FB; -fx-padding: 40;">

    <StackPane alignment="CENTER" maxWidth="160" maxHeight="160">
        <Circle fill="#EEF3FB" stroke="#5E7CE2" strokeWidth="2.5" radius="78"/>
        <Circle fill="#DCE8FF" stroke="#5E7CE2" strokeWidth="1" radius="62"/>
        <Circle fill="#FFFFFF" stroke="#DCE8FF" strokeWidth="1" radius="48"/>
        <VBox alignment="CENTER" spacing="4">
            <Rectangle width="70" height="6" arcWidth="6" arcHeight="6" fill="#2E3440"/>
            <Rectangle width="50" height="6" arcWidth="6" arcHeight="6" fill="#5E7CE2"/>
            <Rectangle width="60" height="6" arcWidth="6" arcHeight="6" fill="#5E7CE2"/>
            <Rectangle width="40" height="6" arcWidth="6" arcHeight="6" fill="#8A7AE6"/>
            <Label text="CRBAS"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2E3440;"/>
        </VBox>
    </StackPane>

    <Label text="Campus Resource Booking &amp; Availability System"
           wrapText="true"
           maxWidth="220"
           alignment="CENTER"
           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #5E7CE2; -fx-text-alignment: center;"/>

    <VBox spacing="15"
          style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 14; -fx-border-radius: 14; -fx-border-color: #DDE3EE; -fx-border-width: 1; -fx-effect: dropshadow(gaussian, rgba(36,48,68,0.08), 8, 0, 0, 2);"
          maxWidth="350">

        <Label text="LOGIN"
               style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #2E3440;"/>

        <VBox spacing="5">
            <Label text="Email / Student ID"
                   style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
            <TextField fx:id="usernameField"
                       promptText="Enter your email or ID"
                       prefWidth="290"
                       style="-fx-background-color: #FFFFFF; -fx-border-color: #DDE3EE; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 9 11;"/>
        </VBox>

        <VBox spacing="5">
            <Label text="Password"
                   style="-fx-font-size: 11px; -fx-text-fill: #6B7280;"/>
            <PasswordField fx:id="passwordField"
                           promptText="Enter your password"
                           prefWidth="290"
                           style="-fx-background-color: #FFFFFF; -fx-border-color: #DDE3EE; -fx-border-radius: 7; -fx-background-radius: 7; -fx-padding: 9 11;"/>
        </VBox>

        <Label fx:id="errorLabel"
               text=""
               style="-fx-text-fill: #D96C6C; -fx-font-size: 11px;"/>

        <Button text="Login"
                onAction="#handleLogin"
                prefWidth="290"
                style="-fx-background-color: #5E7CE2; -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-padding: 10; -fx-background-radius: 8px; -fx-cursor: hand;"/>

    </VBox>

</VBox>
