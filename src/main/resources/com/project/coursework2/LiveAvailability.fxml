<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.project.coursework2.controller.LiveAvailabilityController"
      spacing="12" style="-fx-background-color: #F7F7F7; -fx-padding: 20;"
      stylesheets="@live-availability.css">
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <HBox spacing="14" alignment="CENTER_LEFT">
        <Label text="Live availability — Study rooms" styleClass="title"/>

        <ToggleButton fx:id="btnRoomA" text="Room A" selected="true"
                      styleClass="room-toggle"/>
        <ToggleButton fx:id="btnRoomB" text="Room B" styleClass="room-toggle"/>
        <ToggleButton fx:id="btnRoomC" text="Room C" styleClass="room-toggle"/>

        <Pane HBox.hgrow="ALWAYS"/>

        <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="legend">
            <Region styleClass="dot,dot-free"/>   <Label text="Free"/>
            <Region styleClass="dot,dot-booked"/> <Label text="Booked"/>
            <Region styleClass="dot,dot-yours"/>  <Label text="Yours"/>
            <Region styleClass="dot,dot-closed"/> <Label text="Closed"/>
        </HBox>
    </HBox>

    <HBox fx:id="hourHeader" spacing="6" styleClass="hour-header"/>

    <GridPane fx:id="grid" hgap="6" vgap="6"/>

    <Label fx:id="hint" text="Select a free slot to navigate to the booking form"
           styleClass="hint"/>
</VBox>
