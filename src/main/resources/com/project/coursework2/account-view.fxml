<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.coursework2.controller.AccountController"
            fitToWidth="true"
            style="-fx-background-color: #FDF6EC;">

    <VBox spacing="20" style="-fx-background-color: #FDF6EC; -fx-padding: 30;">

        <Label text="ACCOUNT"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>

        <VBox spacing="15" style="-fx-background-color: white; -fx-padding: 25; -fx-background-radius: 10;" maxWidth="420">

            <Label text="PROFILE"
                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;
                          -fx-border-color: transparent transparent #EEEEEE transparent; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 10 0;"/>

            <HBox spacing="10">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="First Name" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                    <TextField fx:id="firstNameField"/>
                </VBox>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="Last Name" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                    <TextField fx:id="lastNameField"/>
                </VBox>
            </HBox>

            <VBox spacing="4">
                <Label text="Email Address" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                <TextField fx:id="emailField"/>
            </VBox>

            <VBox spacing="4">
                <Label text="User ID" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                <TextField fx:id="idField" editable="false"
                           style="-fx-background-color: #F5F5F5; -fx-text-fill: #9A9A9A;
                                  -fx-border-color: #E0E0E0; -fx-border-radius: 3;"/>
            </VBox>

            <VBox spacing="4">
                <Label text="New Password" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                <PasswordField fx:id="passwordField" promptText="Leave blank to keep current password"/>
            </VBox>

            <Label fx:id="statusLabel" text="" wrapText="true"
                   style="-fx-font-size: 11px; -fx-text-fill: #4AADA8;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Button text="Edit" onAction="#handleEdit"
                        style="-fx-background-color: #7A7A7A; -fx-text-fill: white;
                               -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 6 14;"/>
                <Button text="Save" onAction="#handleSave"
                        style="-fx-background-color: #4AADA8; -fx-text-fill: white;
                               -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 6 14;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Delete Account" onAction="#handleDeleteAccount"
                        style="-fx-background-color: #E8735A; -fx-text-fill: white;
                               -fx-background-radius: 5; -fx-cursor: hand; -fx-font-size: 12px; -fx-padding: 6 14;"/>
            </HBox>

        </VBox>

    </VBox>
</ScrollPane>
