<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.project.coursework2.controller.HomeController"
            fitToWidth="true"
            style="-fx-background-color: #FDF6EC;">

    <VBox spacing="20" style="-fx-background-color: #FDF6EC; -fx-padding: 30;">

        <Label text="HOME DASHBOARD"
               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>

        <!-- Welcome Banner -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-background-color: #4AADA8; -fx-padding: 15 20; -fx-background-radius: 10;">
            <Label fx:id="welcomeLabel" text="Welcome back!"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: white;" HBox.hgrow="ALWAYS"/>
            <Label fx:id="welcomeRoleLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #D0EFED; -fx-background-color: rgba(0,0,0,0.15); -fx-padding: 3 10; -fx-background-radius: 12;"/>
        </HBox>

        <!-- Stats Row -->
        <HBox spacing="15">
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="150">
                <Label text="ACTIVE" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                <Label fx:id="activeCount" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #4AADA8;"/>
                <ProgressBar fx:id="activeProgress" progress="0" prefWidth="120" style="-fx-accent: #4AADA8;"/>
            </VBox>
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="150">
                <Label text="PENDING" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                <Label fx:id="pendingCount" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #E8735A;"/>
            </VBox>
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="150">
                <Label text="RESOURCES" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                <Label fx:id="resourcesCount" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #9B59B6;"/>
            </VBox>
            <VBox spacing="5" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;" prefWidth="150">
                <Label text="HOURS THIS MONTH" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                <Label fx:id="hoursUsed" text="—" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>
            </VBox>
        </HBox>

        <HBox spacing="20">

            <!-- Left Column -->
            <VBox spacing="20" HBox.hgrow="ALWAYS">

                <!-- Live Availability -->
                <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <HBox alignment="CENTER_LEFT" spacing="14">
                        <Label text="Live availability — Study rooms"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>
                        <ToggleButton fx:id="btnRoomA" text="Study Room A" selected="true"
                                      style="-fx-background-radius: 8; -fx-padding: 6 14; -fx-background-color: #EEF0F2; -fx-text-fill: #333;"/>
                        <ToggleButton fx:id="btnRoomB" text="Study Room B"
                                      style="-fx-background-radius: 8; -fx-padding: 6 14; -fx-background-color: #EEF0F2; -fx-text-fill: #333;"/>
                        <ToggleButton fx:id="btnRoomC" text="Study Room C"
                                      style="-fx-background-radius: 8; -fx-padding: 6 14; -fx-background-color: #EEF0F2; -fx-text-fill: #333;"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="■" style="-fx-text-fill: #4AADA8;"/>
                            <Label text="Free" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                            <Label text="■" style="-fx-text-fill: #E8735A;"/>
                            <Label text="Booked" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                            <Label text="■" style="-fx-text-fill: #6BB5FF;"/>
                            <Label text="Yours" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                            <Label text="■" style="-fx-text-fill: #F5C842;"/>
                            <Label text="Closed" style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                        </HBox>
                    </HBox>
                    <HBox fx:id="availabilityHourHeader" spacing="6"/>
                    <GridPane fx:id="availabilityGrid" hgap="6" vgap="6"/>
                    <Label fx:id="availabilityHint" text="Select a free slot to navigate to the booking form"
                           style="-fx-font-size: 11px; -fx-text-fill: #7A7A7A;"/>
                </VBox>

                <!-- Recent Booking History -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Recent booking history"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>
                    <VBox fx:id="recentHistoryContainer" spacing="8">
                        <Label text="Loading..." style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;"/>
                    </VBox>
                </VBox>

            </VBox>

            <!-- Right Column -->
            <VBox spacing="20" prefWidth="280">

                <!-- Next Up -->
                <VBox fx:id="nextUpCard" spacing="8" style="-fx-background-color: #E8F5F4; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Next up" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>
                    <Label text="No upcoming bookings" style="-fx-font-size: 14px; -fx-text-fill: #7A7A7A;"/>
                </VBox>

                <!-- Upcoming This Week -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Upcoming this week" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>
                    <VBox fx:id="upcomingContainer" spacing="8">
                        <Label text="Loading..." style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;"/>
                    </VBox>
                </VBox>

                <!-- Study Room Capacity -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Study room capacity today"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>
                    <VBox fx:id="capacityContainer" spacing="10">
                        <Label text="Loading..." style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;"/>
                    </VBox>
                </VBox>

                <!-- Maintenance Alerts -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <Label text="Maintenance alerts" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #3D3D3D;"/>
                    <VBox fx:id="maintenanceContainer" spacing="8">
                        <Label text="Loading..." style="-fx-font-size: 12px; -fx-text-fill: #7A7A7A;"/>
                    </VBox>
                </VBox>

            </VBox>
        </HBox>
    </VBox>
</ScrollPane>
